	<parameter name="ARG" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="QUINDE_NEGOCIO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="QUINDE_LOGO" class="java.awt.Image" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
PRODUCTS.REFERENCE,
PRODUCTS.NAME,
SUM(TICKETLINES.UNITS) AS UNITS,
SUM(TICKETLINES.UNITS * TICKETLINES.PRICE) AS TOTAL
FROM RECEIPTS, TICKETS, TICKETLINES, PRODUCTS
WHERE RECEIPTS.ID = TICKETS.ID AND TICKETS.ID = TICKETLINES.TICKET AND TICKETLINES.PRODUCT = PRODUCTS.ID
GROUP BY PRODUCTS.REFERENCE, PRODUCTS.NAME
ORDER BY PRODUCTS.NAME]]>
	</queryString>
	<field name="REFERENCE" class="java.lang.String"/>
	<field name="NAME" class="java.lang.String"/>
	<field name="UNITS" class="java.lang.Double"/>
	<field name="TOTAL" class="java.lang.Double"/>
